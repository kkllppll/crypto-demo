{
  "datasets": [
    {
      "name": "latest_prices",
      "displayName": "latest_prices",
      "queryLines": [
        "SELECT\n",
        "  a.symbol,\n",
        "  f.price_usd  AS latest_price_usd,\n",
        "  f.event_time AS last_update\n",
        "FROM fact_price_tick f\n",
        "JOIN dim_asset a ON f.asset_key = a.asset_key\n",
        "QUALIFY ROW_NUMBER() OVER (PARTITION BY a.symbol ORDER BY f.event_time DESC) = 1\n",
        "ORDER BY a.symbol"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "prod_team_crypto_gold"
    },
    {
      "name": "hourly_candles",
      "displayName": "hourly_candles",
      "queryLines": [
        "SELECT\n",
        "  a.symbol,\n",
        "  a.asset_name,\n",
        "  d.full_date,\n",
        "  d.day_name,\n",
        "  d.is_weekend,\n",
        "  s.provider,\n",
        "  f.event_time,\n",
        "  f.hour_of_day,\n",
        "  f.open,\n",
        "  f.high,\n",
        "  f.low,\n",
        "  f.close,\n",
        "  f.volume,\n",
        "  f.price_change_pct\n",
        "FROM fact_ohlc_hourly f\n",
        "JOIN dim_asset  a ON f.asset_key  = a.asset_key\n",
        "JOIN dim_date   d ON f.date_key   = d.date_key\n",
        "JOIN dim_source s ON f.source_key = s.source_key"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "prod_team_crypto_gold"
    },
    {
      "name": "daily_summary",
      "displayName": "daily_summary",
      "queryLines": [
        "SELECT\n",
        "  a.symbol,\n",
        "  d.full_date,\n",
        "  d.day_name,\n",
        "  d.is_weekend,\n",
        "  min_by(f.open, f.event_time)                                        AS day_open,\n",
        "  max_by(f.close, f.event_time)                                       AS day_close,\n",
        "  MIN(f.low)                                                          AS day_low,\n",
        "  MAX(f.high)                                                         AS day_high,\n",
        "  ROUND((max_by(f.close, f.event_time) - min_by(f.open, f.event_time))\n",
        "        / min_by(f.open, f.event_time) * 100, 2)                      AS daily_change_pct,\n",
        "  ROUND(STDDEV(f.price_change_pct), 3)                                AS volatility_pct,\n",
        "  SUM(f.volume)                                                       AS total_volume_coins\n",
        "FROM fact_ohlc_hourly f\n",
        "JOIN dim_asset a ON f.asset_key = a.asset_key\n",
        "JOIN dim_date  d ON f.date_key  = d.date_key\n",
        "GROUP BY a.symbol, d.full_date, d.day_name, d.is_weekend"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "prod_team_crypto_gold"
    },
    {
      "name": "live_ticks",
      "displayName": "live_ticks",
      "queryLines": [
        "SELECT\n",
        "  a.symbol,\n",
        "  d.full_date,\n",
        "  f.event_time,\n",
        "  f.price_usd\n",
        "FROM fact_price_tick f\n",
        "JOIN dim_asset a ON f.asset_key = a.asset_key\n",
        "JOIN dim_date  d ON f.date_key  = d.date_key"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "prod_team_crypto_gold"
    }
  ],
